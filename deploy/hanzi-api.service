[Unit]
Description=Hanzi Train API
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/hanzi-train/server
Environment=ENV=production
ExecStart=/var/www/hanzi-train/server/venv/bin/python main.py
Restart=always
RestartSec=5

# 日志
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target